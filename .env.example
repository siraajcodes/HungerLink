# ==============================================================================
# HUNGERLINK 2.0 — Environment Configuration
# ==============================================================================
# NEVER commit real secrets or service-role keys into source control.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY in VITE_* client variables.

# Required: Shared Supabase Project URL (shared with HungerLink Android app)
VITE_SUPABASE_URL=""

# Required: Supabase public anon key (or current public publishable key sb_publishable_*)
VITE_SUPABASE_ANON_KEY=""

# Optional alias if your Supabase dashboard provides a publishable key name
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Optional: Managed or self-hosted OSRM routing server base URL
# Example: https://routing.yourdomain.org/route/v1/driving
# Leave unset or point to your managed OSRM instance; app gracefully falls back
# to geodesic distance/duration estimation if unavailable.
VITE_OSRM_BASE_URL=""

# Optional: Configurable safety buffer (minutes) before consume_by_time (default: 45)
VITE_DELIVERY_SAFETY_BUFFER_MINUTES="45"

# Optional: Application public base URL for MealTrace QR tracking links
VITE_APP_PUBLIC_URL=""

# Server / Edge Function only (configure via `supabase secrets set`, NEVER in browser):
# SUPABASE_SERVICE_ROLE_KEY=""
# MEALTRACE_HMAC_SECRET=""
